{
  "project": "rust-RCP",
  "standard": "ISO 26262-3:2018",
  "operationalSituations": [
    {
      "id": "OS-001",
      "description": "Normal driving on public road"
    },
    {
      "id": "OS-002",
      "description": "Low-speed manoeuvring in car park"
    },
    {
      "id": "OS-003",
      "description": "Highway cruise-control engaged"
    },
    {
      "id": "OS-004",
      "description": "ECU firmware update in service mode"
    },
    {
      "id": "OS-005",
      "description": "Vehicle stationary, ignition on"
    },
    {
      "id": "OS-006",
      "description": "Emergency stop / rapid deceleration"
    }
  ],
  "hazards": [
    {
      "id": "H-001",
      "description": "Endpoint misaddressing — a request resolves to the wrong (stream_id, byte_bus_id)-addressed endpoint",
      "risk": {
        "severity": "S2",
        "exposure": "E4",
        "controllability": "C2",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-001"
      ]
    },
    {
      "id": "H-002",
      "description": "Safety-tagged request lost — a Critical-priority/safety-tagged request is silently dropped instead of executed or explicitly failed",
      "risk": {
        "severity": "S2",
        "exposure": "E4",
        "controllability": "C2",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-002"
      ]
    },
    {
      "id": "H-003",
      "description": "Replayed request — a previously valid request is re-injected and executed out of its intended context",
      "risk": {
        "severity": "S2",
        "exposure": "E3",
        "controllability": "C2",
        "asil": "ASIL-A"
      },
      "safetyGoals": [
        "SG-003"
      ]
    },
    {
      "id": "H-004",
      "description": "Payload corruption — a bitflip in a safe-point request/response payload causes erroneous actuation",
      "risk": {
        "severity": "S3",
        "exposure": "E4",
        "controllability": "C1",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-004"
      ]
    },
    {
      "id": "H-005",
      "description": "Endpoint/stream lockup undetected — the per-stream watchdog fails to flag an unresponsive endpoint",
      "risk": {
        "severity": "S2",
        "exposure": "E4",
        "controllability": "C2",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-005"
      ]
    },
    {
      "id": "H-006",
      "description": "Unauthorized request execution — a caller dispatches an (endpoint-type, request-type) pair outside its granted allowlist",
      "risk": {
        "severity": "S2",
        "exposure": "E3",
        "controllability": "C2",
        "asil": "ASIL-A"
      },
      "safetyGoals": [
        "SG-006"
      ]
    },
    {
      "id": "H-007",
      "description": "Power-state transition race — requests processed during a Normal/StandBy/Sleep/Unpowered transition or cold/hot start handshake cause undefined behaviour",
      "risk": {
        "severity": "S1",
        "exposure": "E3",
        "controllability": "C3",
        "asil": "ASIL-A"
      },
      "safetyGoals": [
        "SG-007"
      ]
    },
    {
      "id": "H-008",
      "description": "Frame/payload length overflow — a malformed NTSCF/ACF length field enables an oversized allocation or malformed decode",
      "risk": {
        "severity": "S3",
        "exposure": "E4",
        "controllability": "C1",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-008"
      ]
    },
    {
      "id": "H-009",
      "description": "Request flooding denial of service — a flood of Standard-priority requests starves Critical-priority/safety-tagged request dispatch",
      "risk": {
        "severity": "S2",
        "exposure": "E4",
        "controllability": "C2",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-009"
      ]
    },
    {
      "id": "H-010",
      "description": "Register-map integrity bypass — a write reaches a register the RC Server's lifecycle state or root-client policy should have blocked",
      "risk": {
        "severity": "S1",
        "exposure": "E4",
        "controllability": "C3",
        "asil": "ASIL-B"
      },
      "safetyGoals": [
        "SG-010"
      ]
    }
  ],
  "safetyGoals": [
    {
      "id": "SG-001",
      "description": "Requests shall only be delivered to the correct addressed endpoint",
      "hazards": [
        "H-001"
      ],
      "asil": "ASIL-B",
      "fttiMs": 200,
      "fssrRefs": [
        "REQ-EPLK-001",
        "REQ-EPLK-002",
        "REQ-EPLK-003",
        "REQ-EPLK-004"
      ]
    },
    {
      "id": "SG-002",
      "description": "Safety-tagged requests shall not be silently dropped",
      "hazards": [
        "H-002"
      ],
      "asil": "ASIL-B",
      "fttiMs": 100,
      "fssrRefs": [
        "REQ-SAFETY-001",
        "REQ-SAFETY-002",
        "REQ-SAFETY-003",
        "REQ-SAFETY-004",
        "REQ-SAFETY-005"
      ]
    },
    {
      "id": "SG-003",
      "description": "Replayed frames shall be detected and rejected",
      "hazards": [
        "H-003"
      ],
      "asil": "ASIL-A",
      "fttiMs": 500,
      "fssrRefs": [
        "REQ-SEQENF-003"
      ]
    },
    {
      "id": "SG-004",
      "description": "Payload integrity shall be verified before execution",
      "hazards": [
        "H-004"
      ],
      "asil": "ASIL-B",
      "fttiMs": 200,
      "fssrRefs": [
        "REQ-CRC-004"
      ]
    },
    {
      "id": "SG-005",
      "description": "Unresponsive endpoints shall be detected within the watchdog window",
      "hazards": [
        "H-005"
      ],
      "asil": "ASIL-B",
      "fttiMs": 3000,
      "fssrRefs": [
        "REQ-WDG-001",
        "REQ-WDG-002",
        "REQ-WDG-003",
        "REQ-WDG-004",
        "REQ-WDG-005",
        "REQ-WDG-006",
        "REQ-WDG-007",
        "REQ-WDG-008"
      ]
    },
    {
      "id": "SG-006",
      "description": "Only authorized callers may dispatch a given (endpoint-type, request-type) pair",
      "hazards": [
        "H-006"
      ],
      "asil": "ASIL-A",
      "fttiMs": 0,
      "fssrRefs": [
        "REQ-AUTHZ-001",
        "REQ-AUTHZ-002",
        "REQ-AUTHZ-003",
        "REQ-AUTHZ-004",
        "REQ-AUTHZ-005",
        "REQ-AUTHZ-006",
        "REQ-AUTHZ-007"
      ]
    },
    {
      "id": "SG-007",
      "description": "Power state transitions shall be atomic with respect to concurrent requests",
      "hazards": [
        "H-007"
      ],
      "asil": "ASIL-A",
      "fttiMs": 500,
      "fssrRefs": [
        "REQ-PWR-001",
        "REQ-PWR-002",
        "REQ-PWR-003",
        "REQ-PWR-004",
        "REQ-PWR-005",
        "REQ-PWR-006",
        "REQ-PWR-007",
        "REQ-PWR-008",
        "REQ-PWRSTART-001",
        "REQ-PWRSTART-002",
        "REQ-PWRSTART-003",
        "REQ-WAKE-001",
        "REQ-WAKE-002",
        "REQ-WAKE-003",
        "REQ-WAKE-004",
        "REQ-WAKE-005",
        "REQ-WAKE-006",
        "REQ-WAKE-007",
        "REQ-WAKE-008",
        "REQ-WAKE-009"
      ]
    },
    {
      "id": "SG-008",
      "description": "Frame/payload length fields shall be validated before memory allocation",
      "hazards": [
        "H-008"
      ],
      "asil": "ASIL-B",
      "fttiMs": 0,
      "fssrRefs": [
        "REQ-WIRE-001",
        "REQ-WIRE-002",
        "REQ-WIRE-003",
        "REQ-WIRE-004",
        "REQ-WIRE-005",
        "REQ-WIRE-006",
        "REQ-WIRE-007",
        "REQ-WIRE-008",
        "REQ-WIRE-009"
      ]
    },
    {
      "id": "SG-009",
      "description": "Critical-priority/safety-tagged requests shall not be delayed by lower-priority flooding",
      "hazards": [
        "H-009"
      ],
      "asil": "ASIL-B",
      "fttiMs": 100,
      "fssrRefs": [
        "REQ-PRIO-004"
      ]
    },
    {
      "id": "SG-010",
      "description": "Register writes shall be rejected unless permitted by both the current lifecycle state and root-client policy",
      "hazards": [
        "H-010"
      ],
      "asil": "ASIL-B",
      "fttiMs": 200,
      "fssrRefs": [
        "REQ-EP0-001",
        "REQ-EP0-002",
        "REQ-EP0-003",
        "REQ-EP0-004",
        "REQ-EP0-005",
        "REQ-EP0-006",
        "REQ-EP0-007",
        "REQ-EP0-008",
        "REQ-EP0-009",
        "REQ-EP0-010",
        "REQ-EP0-011",
        "REQ-LIFE-001",
        "REQ-LIFE-002",
        "REQ-LIFE-003",
        "REQ-LIFE-004",
        "REQ-LIFE-005",
        "REQ-LIFE-006",
        "REQ-LIFE-007",
        "REQ-LIFE-008",
        "REQ-LIFE-009",
        "REQ-LIFE-010",
        "REQ-LIFE-011",
        "REQ-LIFE-012",
        "REQ-LIFE-015",
        "REQ-LIFE-019"
      ]
    }
  ]
}
